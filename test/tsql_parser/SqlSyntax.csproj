<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(ScriptDomPath)' == ''">
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="161.9142.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(ScriptDomPath)' != ''">
    <Reference Include="Microsoft.SqlServer.TransactSql.ScriptDom">
      <HintPath>$(ScriptDomPath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
